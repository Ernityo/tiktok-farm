+// Several separate touches in one synthesized event, e.g. a typed word: every
+// pointerDown..pointerUp is its own touch (its own event path), at its offset
+// in the sequence. One request instead of one per key, and since each touch
+// lifts before the next starts, the keyboard sees taps, not a swipe.
+static BOOL FBPerformAbsoluteTapSequence(NSArray *actions, NSError **error)
+{
+  NSArray *items = [actions.firstObject objectForKey:@"actions"];
+  CGPoint point = CGPointZero;
+  BOOL hasPoint = NO;
+  NSTimeInterval offset = 0;
+  XCPointerEventPath *eventPath = nil;
+  NSMutableArray<XCPointerEventPath *> *paths = [NSMutableArray array];
+
+  for (NSDictionary *item in items) {
+    NSString *type = [item objectForKey:@"type"];
+    NSTimeInterval duration = [[item objectForKey:@"duration"] doubleValue] / 1000.0;
+    if ([type isEqualToString:@"pause"]) {
+      offset += duration;
+    } else if ([type isEqualToString:@"pointerMove"]) {
+      offset += duration;
+      point = CGPointMake([[item objectForKey:@"x"] doubleValue], [[item objectForKey:@"y"] doubleValue]);
+      hasPoint = YES;
+      if (nil != eventPath) {
+        [eventPath moveToPoint:point atOffset:offset];
+      }
+    } else if ([type isEqualToString:@"pointerDown"] && hasPoint && nil == eventPath) {
+      eventPath = [[XCPointerEventPath alloc] initForTouchAtPoint:point offset:offset];
+    } else if ([type isEqualToString:@"pointerUp"] && nil != eventPath) {
+      [eventPath liftUpAtOffset:offset];
+      [paths addObject:eventPath];
+      eventPath = nil;
+    }
+  }
+  if (nil != eventPath) {
+    [eventPath liftUpAtOffset:offset];
+    [paths addObject:eventPath];
+  }
+  if (0 == paths.count) {
+    return NO;
+  }
+  XCSynthesizedEventRecord *record = [[XCSynthesizedEventRecord alloc]
+                                      initWithName:@"Absolute Tap Sequence"
+                                      interfaceOrientation:UIInterfaceOrientationPortrait];
+  for (XCPointerEventPath *path in paths) {
+    [record addPointerEventPath:path];
+  }
+  return [FBXCTestDaemonsProxy synthesizeEventWithRecord:record error:error];
+}
