++ (id<FBResponsePayload>)handleAbsoluteTapSequence:(FBRouteRequest *)request
+{
+  NSArray *actions = (NSArray *)request.arguments[@"actions"];
+  NSError *error;
+  if (!FBIsAbsoluteSingleTouchAction(actions)) {
+    return FBResponseWithStatus([FBCommandStatus invalidArgumentErrorWithMessage:@"Expected one touch pointer with viewport moves, downs, ups and pauses" traceback:nil]);
+  }
+  if (!FBPerformAbsoluteTapSequence(actions, &error)) {
+    return FBResponseWithUnknownError(error ?: [NSError errorWithDomain:@"com.facebook.WebDriverAgent"
+                                                                    code:1
+                                                                userInfo:@{NSLocalizedDescriptionKey: @"Unable to synthesize the tap sequence"}]);
+  }
+  return FBResponseWithOK();
+}
